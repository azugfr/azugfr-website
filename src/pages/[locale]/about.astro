---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import type { Locale } from "@/lib/i18n";
import type { AboutSection, AboutOrganizer } from "@/content/config";

export function getStaticPaths() {
  return [
    { params: { locale: "fr" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.params as { locale: Locale };

const allAbout = await getCollection("about");

const sections = (allAbout
  .filter((e) => e.data.type === "section")
  .sort((a, b) => (a.data as AboutSection).order - (b.data as AboutSection).order)
  .map((e) => {
    const d = e.data as AboutSection;
    const t = d.translations?.[locale];
    return { ...d, title: t?.title ?? d.title, body: t?.body ?? d.body };
  }));

const organizers = (allAbout
  .filter((e) => e.data.type === "organizer")
  .sort((a, b) => ((a.data as AboutOrganizer).order ?? 0) - ((b.data as AboutOrganizer).order ?? 0))
  .map((e) => {
    const d = e.data as AboutOrganizer;
    const t = d.translations?.[locale];
    return { ...d, role: t?.role ?? d.role };
  }));

const manifesto = sections.find((s) => s.slug === "manifesto");
const mission   = sections.find((s) => s.slug === "mission");
const history   = sections.find((s) => s.slug === "history");

const pageTitle = locale === "fr" ? "À propos | AZUG FR" : "About | AZUG FR";
const heroTitle = locale === "fr" ? "À propos" : "About";
const heroTagline =
  locale === "fr"
    ? "La communauté Azure en France"
    : "The Azure community in France";

const labels = {
  manifesto: locale === "fr" ? "Notre manifeste" : "Our Manifesto",
  mission: locale === "fr" ? "Notre mission" : "Our Mission",
  history: locale === "fr" ? "Notre histoire" : "Our History",
  organizers: locale === "fr" ? "Le Board" : "The Board",
  community: locale === "fr" ? "Rejoignez la communauté" : "Join the Community",
  meetup: "Meetup",
  linkedin: "LinkedIn",
  github: "GitHub",
};
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  activeRoute="about"
  canonicalUrl={`${site.url}/${locale}/about`}
>
  <div class="max-w-4xl mx-auto px-4 py-12">

    <!-- Hero -->
    <section class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">{heroTitle}</h1>
      <p class="text-xl text-azure-600 font-medium">{heroTagline}</p>
    </section>

    <!-- Manifesto -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.manifesto}</h2>
      <blockquote class="border-l-4 border-azure-600 pl-6 italic text-gray-700 text-lg leading-relaxed">
        {manifesto?.body}
      </blockquote>
    </section>

    <!-- Mission -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.mission}</h2>
      <p class="text-gray-700 text-lg leading-relaxed">{mission?.body}</p>
    </section>

    <!-- History -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.history}</h2>
      <p class="text-gray-700 text-lg leading-relaxed">{history?.body}</p>
    </section>

    <!-- Organizers -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">{labels.organizers}</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {organizers.map((org) => (
          <li class="bg-white border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow flex flex-col">
            <div class="flex items-center gap-4 mb-3">
              {org.photo
                ? <img src={org.photo} alt={org.name} class="w-16 h-16 rounded-full object-cover flex-shrink-0" />
                : <div class="w-16 h-16 rounded-full bg-azure-100 flex items-center justify-center flex-shrink-0">
                    <span class="text-2xl font-bold text-azure-700">{org.name.charAt(0)}</span>
                  </div>
              }
              <div class="min-w-0">
                <p class="font-semibold text-gray-900 leading-tight">{org.name}</p>
                <p class="text-azure-600 text-sm mt-0.5">{org.role}</p>
                {org.company && <p class="text-gray-500 text-xs mt-0.5 truncate">{org.company}</p>}
              </div>
            </div>
            {org.mvp && (
              <span class="inline-block self-start text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200 px-2 py-0.5 rounded-full mb-3">
                {org.mvp}
              </span>
            )}
            <div class="flex gap-3 text-sm mt-auto">
              {org.linkedin && (
                <a
                  href={org.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-azure-600 hover:text-azure-800 underline"
                >
                  LinkedIn
                </a>
              )}
              {org.github && (
                <a
                  href={org.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-azure-600 hover:text-azure-800 underline"
                >
                  GitHub
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Community links -->
    <section class="mb-4">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">{labels.community}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href={site.social.meetup}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.meetup}
        </a>
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.linkedin}
        </a>
        <a
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.github}
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
