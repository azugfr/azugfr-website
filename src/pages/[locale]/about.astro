---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import type { Locale } from "@/lib/i18n";
import type { AboutSection } from "@/content/config";
import Avatar from "@/components/ui/Avatar.astro";
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import { getOrganizers } from "@/lib/content/contentHelpers";

export function getStaticPaths() {
  return [
    { params: { locale: "fr" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.params as { locale: Locale };

const allAbout = await getCollection("about");

const sections = (allAbout
  .filter((e) => e.data.type === "section")
  .sort((a, b) => (a.data as AboutSection).order - (b.data as AboutSection).order)
  .map((e) => {
    const d = e.data as AboutSection;
    const t = d.translations?.[locale];
    return { ...d, title: t?.title ?? d.title, body: t?.body ?? d.body };
  }));

const dict = getUiDictionary(locale);
const organizers = await getOrganizers(locale);
const speakerSlugs = new Set((await getCollection("speakers")).map((e) => e.data.slug));

const manifesto = sections.find((s) => s.slug === "manifesto");
const mission   = sections.find((s) => s.slug === "mission");
const history   = sections.find((s) => s.slug === "history");

const pageTitle = locale === "fr" ? "À propos | AZUG FR" : "About | AZUG FR";
const heroTitle = locale === "fr" ? "À propos" : "About";
const heroTagline =
  locale === "fr"
    ? "La communauté Azure en France"
    : "The Azure community in France";

const labels = {
  manifesto: locale === "fr" ? "Notre manifeste" : "Our Manifesto",
  mission: locale === "fr" ? "Notre mission" : "Our Mission",
  history: locale === "fr" ? "Notre histoire" : "Our History",
  community: locale === "fr" ? "Rejoignez la communauté" : "Join the Community",
  meetup: "Meetup",
  linkedin: "LinkedIn",
  github: "GitHub",
};
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  activeRoute="about"
  canonicalUrl={`${site.url}/${locale}/about/`}
>
  <div class="max-w-5xl mx-auto px-4 py-12">

    <!-- Hero -->
    <section class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">{heroTitle}</h1>
      <p class="text-xl text-azure-600 font-medium">{heroTagline}</p>
    </section>

    <!-- Manifesto -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.manifesto}</h2>
      <blockquote class="border-l-4 border-azure-600 pl-6 italic text-gray-700 text-lg leading-relaxed">
        {manifesto?.body}
      </blockquote>
    </section>

    <!-- Mission -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.mission}</h2>
      <p class="text-gray-700 text-lg leading-relaxed">{mission?.body}</p>
    </section>

    <!-- History -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.history}</h2>
      <p class="text-gray-700 text-lg leading-relaxed">{history?.body}</p>
    </section>

    <!-- Organizers -->
    <section id="board" class="mb-12 scroll-mt-20">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">{dict.about.board}</h2>
      <ul class="grid gap-6 md:grid-cols-2">
        {organizers.map((org) => {
          const links = [
            { key: "linkedin", label: "LinkedIn", href: org.links?.linkedin },
            { key: "github", label: "GitHub", href: org.links?.github },
            { key: "x", label: "X", href: org.links?.x },
            { key: "website", label: dict.about.website, href: org.links?.website },
            { key: "sessionize", label: "Sessionize", href: org.links?.sessionize },
            { key: "mvp", label: dict.about.mvpProfile, href: org.links?.mvp },
          ].filter((l) => Boolean(l.href));
          return (
            <li class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col gap-4 hover:shadow-md transition-shadow">
              <div class="flex items-center gap-4">
                <Avatar name={org.name} src={org.photo} size="xl" />
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900">{org.name}</h3>
                  <p class="text-sm text-azure-700">{org.role}</p>
                  {org.company && <p class="text-sm text-gray-600">{org.company}</p>}
                </div>
              </div>
              {org.awards && org.awards.length > 0 && (
                <ul class="flex flex-wrap gap-2" aria-label={dict.about.awards}>
                  {org.awards.map((award) => (
                    <li class="inline-flex items-center gap-1 text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200 px-2 py-0.5 rounded-full">
                      <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.8 4.7 17.6l1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                      </svg>
                      {award}
                    </li>
                  ))}
                </ul>
              )}
              {org.bio && <p class="text-sm text-gray-700 leading-relaxed">{org.bio}</p>}
              {org.expertise && org.expertise.length > 0 && (
                <ul class="flex flex-wrap gap-2" aria-label={dict.about.expertise}>
                  {org.expertise.map((tag) => (
                    <li class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded">{tag}</li>
                  ))}
                </ul>
              )}
              <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 text-sm">
                {links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${org.name} — ${l.label}`}
                    class="text-azure-700 hover:underline"
                  >
                    {l.label}
                  </a>
                ))}
                {speakerSlugs.has(org.slug) && (
                  <a href={getLocalizedRoute(locale, "speakers", org.slug)} class="text-azure-700 hover:underline">
                    {dict.about.seeTalks}
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Community links -->
    <section id="community" class="mb-4 scroll-mt-20">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">{labels.community}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href={site.social.meetup}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.meetup}
        </a>
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.linkedin}
        </a>
        <a
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-azure-600 text-white px-5 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-medium"
        >
          {labels.github}
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
