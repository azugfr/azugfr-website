---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Avatar from "@/components/ui/Avatar.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { site } from "@/data/site";
import type { Locale } from "@/lib/i18n";
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import { formatEventDate, toIsoWithOffset } from "@/lib/dates";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import {
  getFeaturedEvent,
  getLatestPastEvent,
  getLatestNews,
  getLatestTalks,
  getFeaturedSponsors,
  getAllSpeakers,
} from "@/lib/content/contentHelpers";

export async function getStaticPaths() {
  return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const dict = getUiDictionary(locale);
const featuredEvent = await getFeaturedEvent(locale);
const latestPastEvent = featuredEvent ? null : await getLatestPastEvent(locale);
const latestTalks = await getLatestTalks(locale, 6);
const latestNews = await getLatestNews(locale, 3);
const featuredSponsors = await getFeaturedSponsors(locale);
const annualSponsor = featuredSponsors.find((s) => s.tier === "annual");
const partnersWithLogo = featuredSponsors.filter((s) => Boolean(s.logo) && s !== annualSponsor);
const speakerBySlug = new Map((await getAllSpeakers(locale)).map((sp) => [sp.slug, sp]));

const featuredStatus = featuredEvent ? deriveEventStatus(featuredEvent) : null;
const featuredTalks = (featuredEvent?.talks ?? []).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AZUG FR — Azure User Group France",
  url: `${site.url}/${locale}/`,
  logo: `${site.url}/azugfr-logo.png`,
  sameAs: Object.values(site.social),
};
---
<BaseLayout locale={locale} title={site.name + " — " + site.description[locale]} activeRoute="home" canonicalUrl={`${site.url}/${locale}/`} {jsonLd}>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-azure-700 to-azure-900 text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-6">AZUG FR</h1>
      <p class="text-xl text-azure-100 mb-4">Azure User Group France</p>
      <p class="text-lg text-azure-200 mb-10 max-w-2xl mx-auto">
        {site.description[locale]}
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href={getLocalizedRoute(locale, "events")}
           class="bg-white text-azure-700 px-8 py-3 rounded-lg font-semibold hover:bg-azure-50 transition-colors">
          {dict.nav.events}
        </a>
        <a href={site.social.meetup} target="_blank" rel="noopener noreferrer"
           class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-azure-700 transition-colors">
          {locale === "fr" ? "Rejoindre la communauté" : "Join the community"}
        </a>
      </div>
    </div>
  </section>

  <!-- Next event -->
  <section data-testid="next-event" class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">{dict.home.nextEvent}</h2>
      {featuredEvent && featuredStatus ? (
        <div class="bg-white border-l-4 border-azure-600 rounded-lg shadow-sm p-8 flex flex-col md:flex-row gap-6">
          <div class="flex-1">
            <div class="mb-3"><StatusBadge status={featuredStatus} {locale} /></div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              <a href={getLocalizedRoute(locale, "events", featuredEvent.slug)} class="hover:text-azure-600">
                {featuredEvent.title}
              </a>
            </h3>
            <p class="text-gray-600 mb-4">{featuredEvent.summary}</p>
            <div class="flex items-center gap-4 text-sm text-gray-600 mb-6 flex-wrap">
              <time datetime={toIsoWithOffset(featuredEvent.startDate, featuredEvent.timezone)}>
                {formatEventDate(featuredEvent.startDate, locale, "dateLong", featuredEvent.timezone)}
              </time>
              {featuredEvent.venue?.city && <span>{featuredEvent.venue.city}</span>}
            </div>
            {featuredTalks.length > 0 && (
              <ul class="mb-6 space-y-2 text-sm text-gray-700">
                {featuredTalks.map((t) => (
                  <li>
                    <span class="font-medium">{t.title}</span>
                    {t.speakerSlugs.length > 0 && (
                      <span class="text-gray-500">
                        {" — "}
                        {t.speakerSlugs.map((slug) => speakerBySlug.get(slug)?.name).filter(Boolean).join(", ")}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {featuredStatus === "upcoming" && featuredEvent.registrationUrl && (
              <a href={featuredEvent.registrationUrl} target="_blank" rel="noopener noreferrer"
                 class="bg-azure-600 text-white px-6 py-3 rounded-lg hover:bg-azure-700 transition-colors font-semibold inline-block">
                {dict.ga.register}
              </a>
            )}
          </div>
        </div>
      ) : (
        <div data-testid="next-event-empty" class="bg-gradient-to-br from-azure-50 to-white border border-azure-100 rounded-xl p-8 md:p-10 flex flex-col md:flex-row gap-8">
          <div class="flex-1">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">{dict.home.comingSoonTitle}</h3>
            <p class="text-gray-700 mb-6">{dict.home.comingSoonBody}</p>
            <div class="flex gap-4 flex-wrap">
              <a href={site.social.meetup} target="_blank" rel="noopener noreferrer"
                 class="bg-azure-600 text-white px-6 py-2.5 rounded-lg hover:bg-azure-700 transition-colors font-semibold">
                {dict.home.followMeetup}
              </a>
              <a href={`mailto:${site.contactEmail}`}
                 class="border border-azure-600 text-azure-700 px-6 py-2.5 rounded-lg hover:bg-azure-50 transition-colors font-semibold">
                {dict.home.proposeTalk}
              </a>
            </div>
          </div>
          {latestPastEvent && (
            <div data-testid="latest-event" class="md:w-80 bg-white border border-gray-200 rounded-xl p-5 self-start">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">{dict.home.lastEvent}</p>
              <h4 class="font-semibold text-gray-900 mb-2">
                <a href={getLocalizedRoute(locale, "events", latestPastEvent.slug)} class="hover:text-azure-700 hover:underline">
                  {latestPastEvent.title}
                </a>
              </h4>
              <p class="text-sm text-gray-600">
                <time datetime={toIsoWithOffset(latestPastEvent.startDate, latestPastEvent.timezone)}>
                  {formatEventDate(latestPastEvent.startDate, locale, "date", latestPastEvent.timezone)}
                </time>
                {latestPastEvent.talks?.length ? ` · ${dict.events.talksCount(latestPastEvent.talks.length)}` : ""}
              </p>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Latest talks -->
  {latestTalks.length > 0 && (
    <section class="bg-gray-50 py-16 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center justify-between mb-8 gap-4 flex-wrap">
          <h2 class="text-3xl font-bold text-gray-900">{dict.home.latestTalks}</h2>
          <a href={`${getLocalizedRoute(locale, "events")}#past`} class="text-azure-700 hover:underline text-sm">
            {dict.home.allEvents} →
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latestTalks.map(({ talk, event, speakers }) => (
            <li class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col gap-3">
              <time class="text-xs text-gray-500" datetime={toIsoWithOffset(event.startDate, event.timezone)}>
                {formatEventDate(event.startDate, locale, "date", event.timezone)}
              </time>
              <h3 class="font-semibold text-gray-900 line-clamp-3">{talk.title}</h3>
              {speakers.length > 0 && (
                <ul class="flex flex-wrap gap-3">
                  {speakers.map((sp) => (
                    <li class="flex items-center gap-2">
                      <Avatar name={sp.name} src={sp.photo} size="sm" />
                      <a href={getLocalizedRoute(locale, "speakers", sp.slug)} class="text-sm text-gray-800 hover:text-azure-700 hover:underline">
                        {sp.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <a href={getLocalizedRoute(locale, "events", event.slug)} class="text-sm text-azure-700 hover:underline mt-auto">
                {event.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Latest News Section -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-900">
          {locale === "fr" ? "Dernières actualités" : "Latest news"}
        </h2>
        <a href={getLocalizedRoute(locale, "news")} class="text-azure-600 hover:underline text-sm">
          {locale === "fr" ? "Toutes les actualités" : "All news"} →
        </a>
      </div>
      {latestNews.length > 0 ? (
        <ul class="grid gap-6 md:grid-cols-3">
          {latestNews.map(item => (
            <li class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <time class="text-xs text-gray-500 mb-2 block" datetime={item.publishedAt}>
                {formatEventDate(item.publishedAt, locale, "dateLong")}
              </time>
              <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">
                <a href={getLocalizedRoute(locale, "news", item.slug)} class="hover:text-azure-600">
                  {item.title}
                </a>
              </h3>
              <p class="text-sm text-gray-600 line-clamp-3">{item.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-gray-500">{dict.common.noResults}</p>
      )}
    </div>
  </section>

  <!-- Annual sponsor -->
  {annualSponsor && (
    <section class="py-16 px-4 bg-gray-50 border-t border-gray-100" data-testid="annual-sponsor" aria-labelledby="annual-sponsor-title">
      <div class="max-w-3xl mx-auto text-center">
        <p id="annual-sponsor-title" class="text-sm font-semibold uppercase tracking-wide text-azure-700">
          {annualSponsor.year ? dict.sponsors.annualTitle(annualSponsor.year) : dict.sponsors.tiers.annual}
        </p>
        <a
          href={annualSponsor.website}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center rounded-xl bg-white border border-gray-200 px-10 py-6 hover:shadow-md transition-shadow"
        >
          {annualSponsor.logo ? (
            <img src={annualSponsor.logo} alt={annualSponsor.alt ?? annualSponsor.name} class="h-14 max-w-[240px] object-contain" />
          ) : (
            <span class="text-2xl font-semibold text-gray-900">{annualSponsor.name}</span>
          )}
        </a>
        <p class="mt-6 text-gray-600">{dict.sponsors.thanks(annualSponsor.name)}</p>
      </div>
    </section>
  )}

  <!-- Partners (only when at least one featured sponsor has a logo) -->
  {partnersWithLogo.length > 0 && (
    <section class="py-16 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
          {locale === "fr" ? "Nos partenaires" : "Our partners"}
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-items-center">
          {partnersWithLogo.map((sp) => (
            <a href={sp.website} target="_blank" rel="noopener noreferrer">
              <img src={sp.logo} alt={sp.alt ?? sp.name} class="h-12 object-contain" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>
