---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EventCard from "@/components/events/EventCard.astro";
import {
  getUpcomingEvents,
  getArchivedEvents,
  getAllSpeakers,
  groupByYear,
} from "@/lib/content/contentHelpers";
import { getEventSpeakerSlugs } from "@/lib/content/speakerDerive";
import { getUiDictionary } from "@/lib/i18n";
import type { Locale } from "@/lib/i18n";
import type { EventEntry } from "@/content/config";
import { site } from "@/data/site";

export async function getStaticPaths() {
  return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const dict = getUiDictionary(locale);
const upcoming = await getUpcomingEvents(locale);
const archived = await getArchivedEvents(locale);
const years = groupByYear(archived);
const allSpeakers = await getAllSpeakers(locale);
const speakerBySlug = new Map(allSpeakers.map((s) => [s.slug, s]));
const speakersOf = (e: EventEntry) =>
  getEventSpeakerSlugs(e)
    .map((slug) => speakerBySlug.get(slug))
    .filter((s): s is NonNullable<typeof s> => Boolean(s));

const title = locale === "fr" ? "Événements | AZUG FR" : "Events | AZUG FR";
const description = locale === "fr"
  ? "Découvrez les prochains événements et les archives de la communauté Azure en France."
  : "Discover upcoming events and archives from the French Azure community.";
const canonicalUrl = `${site.url}/${locale}/events/`;
---

<BaseLayout {locale} {title} {description} {canonicalUrl} activeRoute="events">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-10">
      {locale === "fr" ? "Événements" : "Events"}
    </h1>

    <!-- Upcoming section -->
    <section id="upcoming" aria-labelledby="upcoming-h" class="mb-16 scroll-mt-20">
      <h2 id="upcoming-h" class="text-2xl font-semibold text-gray-800 mb-6">{dict.events.upcomingHeading}</h2>
      {upcoming.length === 0 ? (
        <div data-testid="upcoming-empty" class="bg-gray-50 rounded-xl p-8 text-center">
          <p class="text-gray-600 mb-6">{dict.events.noUpcoming}</p>
          <div class="flex justify-center gap-4 flex-wrap">
            <a
              href={site.social.meetup}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-azure-600 hover:bg-azure-700 text-white px-6 py-2.5 rounded-lg font-semibold transition-colors"
            >
              {dict.home.followMeetup}
            </a>
            <a
              href={`mailto:${site.contactEmail}`}
              class="border border-azure-600 text-azure-700 hover:bg-azure-50 px-6 py-2.5 rounded-lg font-semibold transition-colors"
            >
              {dict.home.proposeTalk}
            </a>
          </div>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {upcoming.map((event) => <EventCard {event} {locale} speakers={speakersOf(event)} />)}
        </ul>
      )}
    </section>

    <!-- Past section -->
    <section id="past" aria-labelledby="past-h" class="scroll-mt-20">
      <h2 id="past-h" class="text-2xl font-semibold text-gray-800 mb-6">{dict.events.pastHeading}</h2>
      {archived.length === 0 ? (
        <p class="text-gray-500">{dict.common.noResults}</p>
      ) : (
        <>
          <nav aria-label={dict.events.byYear} class="flex flex-wrap gap-2 mb-8">
            {years.map(({ year, events }) => (
              <a
                href={`#year-${year}`}
                class="px-3 py-1 rounded-full border border-gray-200 text-sm hover:border-azure-600 hover:text-azure-700"
              >
                {year} <span class="text-gray-500">({events.length})</span>
              </a>
            ))}
          </nav>
          {years.map(({ year, events }) => (
            <>
              <h3 id={`year-${year}`} class="text-xl font-semibold text-gray-800 mt-10 mb-4 scroll-mt-20">
                {year}
              </h3>
              <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {events.map((event) => <EventCard {event} {locale} speakers={speakersOf(event)} />)}
              </ul>
            </>
          ))}
        </>
      )}
    </section>
  </div>
</BaseLayout>
