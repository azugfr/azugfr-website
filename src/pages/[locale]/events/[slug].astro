---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllEvents, getSpeakerBySlug } from "@/lib/content/contentHelpers";
import { getUiDictionary, getLocalizedRoute, resolveLocaleContent } from "@/lib/i18n";
import type { Locale } from "@/lib/i18n";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import { site } from "@/data/site";

export async function getStaticPaths() {
  const locales: Locale[] = ["fr", "en"];
  const paths: { params: { locale: Locale; slug: string } }[] = [];
  const entries = await getCollection("events");
  const seen = new Set<string>();
  for (const locale of locales) {
    for (const entry of entries) {
      const key = `${locale}:${entry.data.slug}`;
      if (!seen.has(key)) {
        seen.add(key);
        paths.push({ params: { locale, slug: entry.data.slug } });
      }
    }
  }
  return paths;
}

function formatDate(iso: string, locale: Locale): string {
  return new Date(iso).toLocaleDateString(locale === "fr" ? "fr-FR" : "en-GB", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function venueModeLabel(mode: string, locale: Locale): string {
  const labels: Record<string, Record<Locale, string>> = {
    in_person: { fr: "En présentiel", en: "In person" },
    online: { fr: "En ligne", en: "Online" },
    hybrid: { fr: "Hybride", en: "Hybrid" },
  };
  return labels[mode]?.[locale] ?? mode;
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const dict = getUiDictionary(locale);

const allEntries = await getCollection("events");
const entry = allEntries.find(e => e.data.slug === slug);
if (!entry) return Astro.redirect(`/${locale}/events`);

const event = resolveLocaleContent(entry.data, locale);
const status = deriveEventStatus(event);

const speakers = await Promise.all(
  (event.speakerSlugs ?? []).map(s => getSpeakerBySlug(s, locale))
);
const resolvedSpeakers = speakers.filter((s): s is NonNullable<typeof s> => Boolean(s));

const title = `${event.title} | AZUG FR`;
const description = event.summary;
const canonicalUrl = `${site.url}/${locale}/events/${slug}`;
---

<BaseLayout {locale} {title} {description} {canonicalUrl} activeRoute="events">
  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back link -->
    <a
      href={getLocalizedRoute(locale, "events")}
      class="text-azure-600 hover:underline text-sm inline-flex items-center gap-1"
    >
      ← {dict.common.backTo} {dict.nav.events}
    </a>

    <!-- Hero -->
    <h1 class="text-4xl font-bold text-gray-900 mt-6 mb-4">{event.title}</h1>

    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 mb-8">
      <time datetime={event.startDate}>{formatDate(event.startDate, locale)}</time>
      {event.venue?.city && <span>📍 {event.venue.city}</span>}
      {event.venue?.mode && (
        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200">
          {venueModeLabel(event.venue.mode, locale)}
        </span>
      )}
      <span
        class={`px-3 py-1 rounded-full text-xs font-semibold ${
          status === "upcoming"
            ? "bg-blue-100 text-blue-700"
            : "bg-gray-100 text-gray-600"
        }`}
      >
        {status === "upcoming" ? dict.common.upcoming : dict.common.past}
      </span>
    </div>

    <!-- Description / Summary -->
    {event.description ? (
      <div class="prose max-w-none text-gray-700 mb-8" set:html={event.description} />
    ) : event.summary ? (
      <p class="text-lg text-gray-700 mb-8">{event.summary}</p>
    ) : null}

    <!-- Registration CTA -->
    {event.registrationUrl && status === "upcoming" && (
      <a
        href={event.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-azure-600 text-white px-6 py-3 rounded-lg hover:bg-azure-700 transition-colors font-semibold mb-10"
      >
        {dict.hero.register}
      </a>
    )}

    <!-- Speakers -->
    {resolvedSpeakers.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold mb-6">
          {locale === "fr" ? "Intervenants" : "Speakers"}
        </h2>
        <ul class="grid gap-4 md:grid-cols-2">
          {resolvedSpeakers.map(s => (
            <li class="flex items-center gap-4 p-4 border rounded-lg">
              {s.photo && (
                <img
                  src={s.photo}
                  alt={s.name}
                  class="w-12 h-12 rounded-full object-cover flex-shrink-0"
                />
              )}
              <div>
                <a
                  href={getLocalizedRoute(locale, "speakers", s.slug)}
                  class="font-semibold hover:text-azure-600 transition-colors"
                >
                  {s.name}
                </a>
                {s.headline && <p class="text-sm text-gray-600">{s.headline}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
