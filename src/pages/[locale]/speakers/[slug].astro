---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSpeakerProfile, getRelatedEventsForSpeaker, getTalksForSpeaker } from "@/lib/content/contentHelpers";
import Avatar from "@/components/ui/Avatar.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import type { Locale } from "@/lib/i18n";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import { site } from "@/data/site";
import { formatEventDate } from "@/lib/dates";

export async function getStaticPaths() {
  const locales: Locale[] = ["fr", "en"];
  const paths = [];
  for (const locale of locales) {
    const entries = await getCollection("speakers");
    for (const entry of entries) {
      paths.push({ params: { locale, slug: entry.data.slug } });
    }
  }
  const seen = new Set<string>();
  return paths.filter(p => {
    const key = `${p.params.locale}:${p.params.slug}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const dict = getUiDictionary(locale);
const speaker = await getSpeakerProfile(slug, locale);
if (!speaker) return Astro.redirect(`/${locale}/speakers/`);
const relatedEvents = await getRelatedEventsForSpeaker(slug, locale);
const talkRows = await getTalksForSpeaker(slug, locale);
const talkEventSlugs = new Set(talkRows.map((r) => r.event.slug));
const attendedEvents = relatedEvents.filter((e) => !talkEventSlugs.has(e.slug));

const title = `${speaker.name} | AZUG FR`;
const description = speaker.headline ?? speaker.bio ?? "";
const canonicalUrl = `${site.url}/${locale}/speakers/${slug}/`;

const subtitle = speaker.headline ?? [speaker.role, speaker.company].filter(Boolean).join(" · ");
const linkDefs = [
  { label: "LinkedIn", href: speaker.links?.linkedin },
  { label: "GitHub", href: speaker.links?.github },
  { label: dict.about.website, href: speaker.links?.website },
  { label: "X / Twitter", href: speaker.links?.x },
  { label: "Sessionize", href: speaker.links?.sessionize },
  { label: dict.about.mvpProfile, href: (speaker.links as { mvp?: string } | undefined)?.mvp },
].filter((l) => Boolean(l.href));
const emptyProfile = !speaker.headline && !speaker.bio && linkDefs.length === 0;
const pill =
  "inline-flex items-center text-xs px-3 py-1 rounded-full border border-azure-200 text-azure-700 hover:bg-azure-50";
---

<BaseLayout {locale} {title} {description} {canonicalUrl} activeRoute="speakers">
  <article class="max-w-4xl mx-auto px-4 py-12">
    <a href={getLocalizedRoute(locale, "speakers")} class="text-azure-700 hover:underline text-sm">
      ← {dict.common.backTo} {dict.nav.speakers}
    </a>

    <!-- Header -->
    <div class="mt-8 flex flex-col md:flex-row gap-8 items-start">
      <Avatar name={speaker.name} src={speaker.photo} size="xl" />
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{speaker.name}</h1>
        {subtitle && <p class="text-xl text-gray-600 mb-3">{subtitle}</p>}
        {speaker.location && <p class="text-sm text-gray-600 mb-3">{speaker.location}</p>}
        {speaker.isOrganizer && (
          <p class="mb-3">
            <span class="text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200 px-2 py-0.5 rounded-full">
              {dict.speakers.organizerBadge}
            </span>
          </p>
        )}
        {speaker.awards && speaker.awards.length > 0 && (
          <ul class="flex flex-wrap gap-2 mb-4" aria-label={dict.about.awards}>
            {speaker.awards.map((award) => (
              <li class="text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200 px-2 py-0.5 rounded-full">{award}</li>
            ))}
          </ul>
        )}
        {linkDefs.length > 0 && (
          <div class="flex flex-wrap gap-x-4 gap-y-2">
            {linkDefs.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${speaker.name} — ${l.label}`}
                class="text-azure-700 hover:underline text-sm"
              >
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    {speaker.bio && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">{locale === "fr" ? "Biographie" : "Biography"}</h2>
        <p class="text-gray-700 leading-relaxed">{speaker.bio}</p>
      </section>
    )}

    {speaker.expertise && speaker.expertise.length > 0 && (
      <section class="mt-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-3">{dict.about.expertise}</h2>
        <div class="flex flex-wrap gap-2">
          {speaker.expertise.map((tag) => (
            <span class="bg-azure-50 text-azure-700 px-3 py-1 rounded-full text-sm">{tag}</span>
          ))}
        </div>
      </section>
    )}

    {emptyProfile && (
      <p class="mt-8 text-sm text-gray-500">
        {dict.speakers.completeProfile.replace("{name}", speaker.name)}{" "}
        <a href={`mailto:${site.contactEmail}`} class="text-azure-700 hover:underline">{site.contactEmail}</a>
      </p>
    )}

    {(talkRows.length > 0 || attendedEvents.length > 0) && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">{dict.speakers.talks}</h2>
        <ul class="grid gap-4">
          {talkRows.map(({ talk, event }) => (
            <li class="p-4 border border-gray-200 rounded-xl">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold text-gray-900">{talk.title}</p>
                  <p class="text-sm text-gray-600 mt-1">
                    <a href={getLocalizedRoute(locale, "events", event.slug)} class="text-azure-700 hover:underline">{event.title}</a>
                    {" · "}{formatEventDate(event.startDate, locale, "date", event.timezone)}
                  </p>
                </div>
                <StatusBadge status={deriveEventStatus(event)} {locale} />
              </div>
              {(talk.slidesUrl || talk.videoUrl) && (
                <p class="mt-3 flex flex-wrap gap-2">
                  {talk.slidesUrl && <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class={pill}>{dict.events.slides}</a>}
                  {talk.videoUrl && <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class={pill}>{dict.events.video}</a>}
                </p>
              )}
            </li>
          ))}
          {attendedEvents.map((event) => (
            <li class="p-4 border border-gray-200 rounded-xl">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <a href={getLocalizedRoute(locale, "events", event.slug)} class="font-semibold text-gray-900 hover:text-azure-700">{event.title}</a>
                  <p class="text-sm text-gray-600 mt-1">
                    {dict.speakers.attended}{" · "}{formatEventDate(event.startDate, locale, "date", event.timezone)}
                  </p>
                </div>
                <StatusBadge status={deriveEventStatus(event)} {locale} />
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
