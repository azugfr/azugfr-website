---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { globalAzureData } from "@/data/globalAzure";
import { site } from "@/data/site";
import type { Locale } from "@/lib/i18n";
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import { getAllEvents } from "@/lib/content/contentHelpers";
import { getEventSpeakerSlugs } from "@/lib/content/speakerDerive";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import { formatEventDate, getBuildNow } from "@/lib/dates";

export function getStaticPaths() {
  return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const dict = getUiDictionary(locale);
const events = await getAllEvents(locale);
const buildYear = getBuildNow().getFullYear();

const editions = globalAzureData.editions.map((edition) => {
  const event = edition.eventSlug ? events.find((e) => e.slug === edition.eventSlug) : undefined;
  const status = event ? deriveEventStatus(event) : edition.year < buildYear ? "past" : "upcoming";
  const date = event ? formatEventDate(event.startDate, locale, "date", event.timezone) : edition.date?.[locale];
  const description = event ? event.summary : edition.description?.[locale];
  const sessions = event?.talks?.length ?? 0;
  const speakers = event ? getEventSpeakerSlugs(event).length : 0;
  const stats = [
    sessions > 0 ? dict.ga.sessions(sessions) : null,
    speakers > 0 ? dict.ga.speakers(speakers) : null,
  ].filter(Boolean).join(" · ");
  return { edition, event, status, date, description, stats };
});

const pageTitle = "Global Azure France | AZUG FR";
const pageDescription = globalAzureData.hero[locale];

const labels = {
  about:       locale === "fr" ? "Qu'est-ce que le Global Azure ?" : "What is Global Azure?",
  editions:    locale === "fr" ? "Nos éditions" : "Our editions",
  stayInformed: locale === "fr" ? "Rester informé" : "Stay informed",
  ctaBody: locale === "fr"
    ? "Les annonces sur les prochaines éditions du Global Azure France sont partagées via nos canaux communautaires. Rejoignez-nous pour ne rien manquer."
    : "Announcements about upcoming Global Azure France editions are shared via our community channels. Join us to stay in the loop.",
  meetup:   "Meetup",
  linkedin: "LinkedIn",
};
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${site.url}/${locale}/global-azure-france`}
  activeRoute="global-azure-france"
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#0078D4] to-[#004E8C] text-white py-20">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">
        Global Azure France
      </h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed">
        {pageDescription}
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.about}</h2>
    <p class="text-gray-700 text-lg leading-relaxed">{globalAzureData.about[locale]}</p>
  </section>

  <!-- Editions -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-2xl font-semibold text-gray-800 mb-8">{labels.editions}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {editions.map(({ edition, event, status, date, description, stats }) => {
          const btnPrimary = "inline-block bg-[#0078D4] text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-[#005A9E] transition-colors";
          const btnSecondary = "inline-block border border-[#0078D4] text-[#005A9E] text-sm font-medium px-4 py-2 rounded-lg hover:bg-azure-50 transition-colors";
          const registerUrl = event?.registrationUrl ?? edition.url;
          return (
            <article data-testid="ga-edition" data-year={String(edition.year)} class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm flex flex-col gap-3">
              <div>
                <h3 class="text-xl font-bold text-[#0078D4]">{edition.year}</h3>
                <p class="text-sm font-semibold text-gray-800 mt-0.5">{edition.city}</p>
                {date && <p class="text-xs text-gray-500 mt-1">{date}</p>}
              </div>
              {description && (
                <p class="text-gray-700 text-sm leading-relaxed flex-1">{description}</p>
              )}
              {stats && <p class="text-xs text-gray-500">{stats}</p>}
              <div class="flex flex-wrap gap-2 mt-auto">
                {status === "upcoming" && registerUrl ? (
                  <a href={registerUrl} target="_blank" rel="noopener noreferrer" class={btnPrimary}>
                    {dict.ga.register}
                  </a>
                ) : event ? (
                  <a href={getLocalizedRoute(locale, "events", event.slug)} class={btnSecondary}>
                    {dict.ga.viewAgenda}
                  </a>
                ) : edition.url ? (
                  <a href={edition.url} target="_blank" rel="noopener noreferrer" class={btnSecondary}>
                    {dict.ga.meetupPage}
                  </a>
                ) : null}
                {edition.recap && (
                  <a href={edition.recap[locale]} target="_blank" rel="noopener noreferrer" class={btnSecondary}>
                    {dict.ga.recap}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">{labels.stayInformed}</h2>
    <p class="text-gray-700 text-lg leading-relaxed mb-6">{labels.ctaBody}</p>
    <div class="flex flex-wrap gap-4">
      <a
        href={site.social.meetup}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#0078D4] text-white px-5 py-2.5 rounded-lg hover:bg-[#005A9E] transition-colors font-medium"
      >
        {labels.meetup}
      </a>
      <a
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#0078D4] text-white px-5 py-2.5 rounded-lg hover:bg-[#005A9E] transition-colors font-medium"
      >
        {labels.linkedin}
      </a>
    </div>
  </section>

</BaseLayout>
