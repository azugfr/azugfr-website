---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { globalAzureData } from "@/data/globalAzure";
import { site } from "@/data/site";
import type { Locale } from "@/lib/i18n";
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import { getAllEvents } from "@/lib/content/contentHelpers";
import { getEventSpeakerSlugs } from "@/lib/content/speakerDerive";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import { formatEventDate, getBuildNow } from "@/lib/dates";

export function getStaticPaths() {
  return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const dict = getUiDictionary(locale);
const events = await getAllEvents(locale);
const buildYear = getBuildNow().getFullYear();

const editions = globalAzureData.editions.map((edition) => {
  const event = edition.eventSlug ? events.find((e) => e.slug === edition.eventSlug) : undefined;
  const status = event ? deriveEventStatus(event) : edition.year < buildYear ? "past" : "upcoming";
  const date = event ? formatEventDate(event.startDate, locale, "date", event.timezone) : edition.date?.[locale];
  const description = event ? event.summary : edition.description?.[locale];
  const sessions = event?.talks?.length ?? 0;
  const speakers = event ? getEventSpeakerSlugs(event).length : 0;
  const stats = [
    sessions > 0 ? dict.ga.sessions(sessions) : null,
    speakers > 0 ? dict.ga.speakers(speakers) : null,
  ].filter(Boolean).join(", ");
  return { edition, event, status, date, description, stats };
});

const pageTitle = "Global Azure France | AZUG FR";
const pageDescription = globalAzureData.hero[locale];

const labels = {
  about:       locale === "fr" ? "Qu'est-ce que le Global Azure ?" : "What is Global Azure?",
  editions:    locale === "fr" ? "Nos éditions" : "Our editions",
  stayInformed: locale === "fr" ? "Rester informé" : "Stay informed",
  ctaBody: locale === "fr"
    ? "Les annonces sur les prochaines éditions du Global Azure France sont partagées via nos canaux communautaires. Rejoignez-nous pour ne rien manquer."
    : "Announcements about upcoming Global Azure France editions are shared via our community channels. Join us to stay in the loop.",
  meetup:   "Meetup",
  linkedin: "LinkedIn",
};
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${site.url}/${locale}/global-azure-france/`}
  activeRoute="global-azure-france"
>

  <!-- Hero -->
  <section class="on-ciel bg-ciel text-encre">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-16">
      <h1 class="t-h1 mb-4">Global Azure France</h1>
      <p class="text-lead measure">{pageDescription}</p>
    </div>
  </section>

  <!-- About -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 py-12">
    <h2 class="t-h2 mb-4">{labels.about}</h2>
    <p class="measure">{globalAzureData.about[locale]}</p>
  </section>

  <!-- Editions -->
  <section class="bg-brume py-12">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <h2 class="t-h2 mb-8">{labels.editions}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {editions.map(({ edition, event, status, date, description, stats }) => {
          const registerUrl = event?.registrationUrl ?? edition.url;
          return (
            <article data-testid="ga-edition" data-year={String(edition.year)} class="bg-papier rounded-panel border border-trait p-6 flex flex-col gap-3">
              <div>
                <h3 class="t-h2 t-num">{edition.year}</h3>
                <p class="t-h3 mt-1">{edition.city}</p>
                {date && <p class="t-meta text-gris mt-1">{date}</p>}
              </div>
              {description && (
                <p class="t-meta text-encre flex-1">{description}</p>
              )}
              {stats && <p class="t-meta text-gris">{stats}</p>}
              <div class="flex flex-wrap gap-x-5 gap-y-2 mt-auto">
                {status === "upcoming" && registerUrl ? (
                  <a href={registerUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    {dict.ga.register}
                  </a>
                ) : event ? (
                  <a href={getLocalizedRoute(locale, "events", event.slug)} class="link">
                    {dict.ga.viewAgenda}
                  </a>
                ) : edition.url ? (
                  <a href={edition.url} target="_blank" rel="noopener noreferrer" class="link">
                    {dict.ga.meetupPage}
                  </a>
                ) : null}
                {edition.recap && (
                  <a href={edition.recap[locale]} target="_blank" rel="noopener noreferrer" class="link">
                    {dict.ga.recap}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 py-12">
    <h2 class="t-h2 mb-4">{labels.stayInformed}</h2>
    <p class="measure mb-6">{labels.ctaBody}</p>
    <div class="flex flex-wrap gap-3">
      <a href={site.social.meetup} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        {labels.meetup}
      </a>
      <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        {labels.linkedin}
      </a>
    </div>
  </section>

</BaseLayout>
