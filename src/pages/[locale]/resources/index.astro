---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getUiDictionary, getLocalizedRoute, resolveLocaleContent } from "@/lib/i18n";
import { formatEventDate, toIsoWithOffset } from "@/lib/dates";
import { getAllEvents } from "@/lib/content/contentHelpers";
import type { Locale } from "@/lib/i18n";
import { site } from "@/data/site";

export async function getStaticPaths() {
  return [{ params: { locale: "fr" } }, { params: { locale: "en" } }];
}

const { locale } = Astro.params as { locale: Locale };
const dict = getUiDictionary(locale);
const entries = await getCollection("resources");
const events = await getAllEvents(locale);

interface ResourceItem {
  type: string;
  url: string;
  title: string;
  summary?: string;
  publishedAt?: string;
  eventSlug?: string;
  eventTitle?: string;
}

const fromCollection: ResourceItem[] = entries.map((e) => resolveLocaleContent(e.data, locale));
const fromTalks: ResourceItem[] = events.flatMap((event) =>
  (event.talks ?? []).flatMap((talk) => [
    ...(talk.slidesUrl
      ? [{ type: "slides", url: talk.slidesUrl, title: talk.title, publishedAt: event.startDate, eventSlug: event.slug, eventTitle: event.title }]
      : []),
    ...(talk.videoUrl
      ? [{ type: "video", url: talk.videoUrl, title: talk.title, publishedAt: event.startDate, eventSlug: event.slug, eventTitle: event.title }]
      : []),
  ]),
);
const resources = [...fromCollection, ...fromTalks].sort((a, b) =>
  (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""),
);

const pageTitle =
  locale === "fr" ? "Ressources | AZUG FR" : "Resources | AZUG FR";
const pageDescription =
  locale === "fr"
    ? "Découvrez les présentations, vidéos et articles partagés par la communauté AZUG FR."
    : "Browse slides, videos and articles shared by the AZUG FR community.";

function typeIcon(type: string): string {
  switch (type) {
    case "slides":
      return "📊";
    case "video":
      return "🎬";
    case "article":
      return "📝";
    case "repository":
      return "💻";
    default:
      return "🔗";
  }
}

---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  activeRoute="resources"
  canonicalUrl={`${site.url}/${locale}/resources`}
>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      {locale === "fr" ? "Ressources" : "Resources"}
    </h1>
    <p class="text-gray-600 mb-10">{pageDescription}</p>

    {
      resources.length === 0 ? (
        <div class="bg-gray-50 rounded-xl p-10 text-center">
          <p class="text-gray-800 font-medium mb-2">{dict.resources.empty}</p>
          <p class="text-gray-600 mb-6">{dict.resources.emptyCta}</p>
          <a
            href={`mailto:${site.contactEmail}`}
            class="inline-block bg-azure-600 hover:bg-azure-700 text-white px-6 py-2.5 rounded-lg font-semibold transition-colors"
          >
            {dict.home.proposeTalk}
          </a>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {resources.map((r) => (
            <li class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start gap-3">
                <span class="text-2xl">{typeIcon(r.type)}</span>
                <div class="flex-1">
                  <h2 class="font-semibold text-gray-900 text-lg mb-1">
                    <a
                      href={r.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-azure-600"
                    >
                      {r.title}
                    </a>
                  </h2>
                  {r.summary && (
                    <p class="text-sm text-gray-600 mb-3">{r.summary}</p>
                  )}
                  {r.eventSlug && (
                    <p class="text-sm mb-2">
                      <a href={getLocalizedRoute(locale, "events", r.eventSlug)} class="text-azure-700 hover:underline">
                        {r.eventTitle}
                      </a>
                    </p>
                  )}
                  <div class="flex items-center gap-3 text-xs text-gray-500">
                    {r.publishedAt && (
                      <time datetime={toIsoWithOffset(r.publishedAt)}>
                        {formatEventDate(r.publishedAt, locale, "date")}
                      </time>
                    )}
                    <span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full capitalize">
                      {r.type}
                    </span>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
