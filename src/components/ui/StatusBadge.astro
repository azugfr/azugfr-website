---
import type { DerivedStatus } from "@/lib/content/eventStatus";
import type { Locale } from "@/lib/i18n";
import { getUiDictionary } from "@/lib/i18n";

interface Props {
  status: DerivedStatus;
  locale: Locale;
}

const { status, locale } = Astro.props;
const dict = getUiDictionary(locale);

const classes: Record<DerivedStatus, string> = {
  upcoming: "bg-azure-50 text-azure-700 border border-azure-200",
  past: "bg-gray-100 text-gray-600",
  cancelled: "bg-red-50 text-red-700 border border-red-200",
};
const labels: Record<DerivedStatus, string> = {
  upcoming: dict.common.upcoming,
  past: dict.common.past,
  cancelled: dict.common.cancelled,
};
---

<span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${classes[status]}`}>{labels[status]}</span>
