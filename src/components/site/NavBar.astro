---
import { getUiDictionary, getLocalizedRoute } from "@/lib/i18n";
import type { Locale } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  locale: Locale;
  activeRoute?: string;
  currentPath?: string;
}

const { locale, activeRoute, currentPath } = Astro.props;
const t = getUiDictionary(locale);

const navItems = [
  { key: "home",      label: t.nav.home,      href: `/${locale}` },
  { key: "events",    label: t.nav.events,    href: getLocalizedRoute(locale, "events") },
  { key: "news",      label: t.nav.news,      href: getLocalizedRoute(locale, "news") },
  { key: "speakers",  label: t.nav.speakers,  href: getLocalizedRoute(locale, "speakers") },
  { key: "resources", label: t.nav.resources, href: getLocalizedRoute(locale, "resources") },
  { key: "about",     label: t.nav.about,     href: getLocalizedRoute(locale, "about") },
];

const ctaLabel = locale === "fr" ? "Rejoindre" : "Join";
const ctaHref  = getLocalizedRoute(locale, "about");
---

<header class="w-full bg-white border-b border-[#E1DFDD] h-14 md:h-16 flex items-center px-4 md:px-8">
  <!-- Logo -->
  <a href={`/${locale}`} aria-label="AZUG FR — Home" class="flex-shrink-0">
    <span class="font-bold text-xl text-[#0078D4] leading-none">AZUG <span class="text-[#323130]">FR</span></span>
  </a>

  <!-- Desktop center nav -->
  <nav aria-label="Main navigation" class="hidden md:flex flex-1 justify-center gap-6">
    {navItems.map(({ key, label, href }) => (
      <a
        href={href}
        aria-current={activeRoute === key ? "page" : undefined}
        class={`text-sm transition-colors ${
          activeRoute === key
            ? "text-[#0078D4] font-semibold"
            : "text-[#323130] font-normal hover:text-[#0078D4]"
        }`}
      >
        {label}
      </a>
    ))}
  </nav>

  <!-- Desktop right: LanguageToggle + CTA -->
  <div class="hidden md:flex items-center gap-3 flex-shrink-0">
    <LanguageToggle locale={locale} currentPath={currentPath} />
    <a
      href={ctaHref}
      class="inline-flex items-center px-4 py-2 rounded-lg bg-[#0078D4] text-white text-sm font-semibold hover:bg-[#006ABE] transition-colors"
    >
      {ctaLabel}
    </a>
  </div>

  <!-- Mobile: spacer + LanguageToggle + Hamburger -->
  <div class="flex md:hidden flex-1 justify-end items-center gap-2">
    <LanguageToggle locale={locale} currentPath={currentPath} />
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="w-11 h-11 flex items-center justify-center text-[#323130] hover:text-[#0078D4] transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu (off-canvas overlay) -->
<div
  id="mobile-menu"
  class="hidden md:hidden fixed inset-0 z-50 bg-white flex flex-col pt-16 px-4 pb-8 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
>
  <button
    id="mobile-menu-close"
    type="button"
    aria-label="Close menu"
    class="absolute top-4 right-4 w-11 h-11 flex items-center justify-center text-[#323130] hover:text-[#0078D4]"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <nav aria-label="Mobile navigation links" class="flex flex-col gap-1 mt-2">
    {navItems.map(({ key, label, href }) => (
      <a
        href={href}
        aria-current={activeRoute === key ? "page" : undefined}
        class={`flex items-center min-h-[48px] px-2 text-base border-b border-[#E1DFDD] transition-colors ${
          activeRoute === key
            ? "text-[#0078D4] font-semibold"
            : "text-[#323130] font-normal hover:text-[#0078D4]"
        }`}
      >
        {label}
      </a>
    ))}
    <a
      href={ctaHref}
      class="mt-4 flex items-center justify-center min-h-[48px] rounded-lg bg-[#0078D4] text-white text-base font-semibold hover:bg-[#006ABE] transition-colors"
    >
      {ctaLabel}
    </a>
  </nav>
</div>

<script>
  const btn   = document.getElementById("mobile-menu-btn");
  const close = document.getElementById("mobile-menu-close");
  const menu  = document.getElementById("mobile-menu");

  function openMenu() {
    menu?.classList.remove("hidden");
    btn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
