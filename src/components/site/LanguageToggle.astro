---
import type { Locale } from "@/lib/i18n";
import { swapLocaleInPath } from "@/lib/i18n";

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath } = Astro.props;

const frPath = swapLocaleInPath(currentPath ?? "/fr", "fr");
const enPath = swapLocaleInPath(currentPath ?? "/en", "en");
---

<div
  role="group"
  aria-label="Changer de langue / Switch language"
  class="flex items-center bg-[#F3F2F1] border border-[#D2D0CE] rounded-lg overflow-hidden
         w-20 h-8 md:w-[88px] md:h-10 text-xs md:text-sm"
>
  <a
    href={frPath}
    aria-label="Français"
    hreflang="fr"
    lang="fr"
    aria-current={locale === "fr" ? "true" : undefined}
    class={`flex-1 flex items-center justify-center h-full text-sm font-sans transition-colors
      ${locale === "fr"
        ? "bg-[#0078D4] text-white font-semibold"
        : "text-[#323130] font-normal hover:bg-[#E1DFDD]"
      }`}
  >
    FR
  </a>
  <a
    href={enPath}
    aria-label="English"
    hreflang="en"
    lang="en"
    aria-current={locale === "en" ? "true" : undefined}
    class={`flex-1 flex items-center justify-center h-full text-sm font-sans transition-colors
      ${locale === "en"
        ? "bg-[#0078D4] text-white font-semibold"
        : "text-[#323130] font-normal hover:bg-[#E1DFDD]"
      }`}
  >
    EN
  </a>
</div>
