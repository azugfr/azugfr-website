---
import type { EventEntry, SpeakerEntry } from "@/content/config";
import type { Locale } from "@/lib/i18n";
import { getLocalizedRoute, getUiDictionary } from "@/lib/i18n";
import { deriveEventStatus } from "@/lib/content/eventStatus";
import { formatEventDate, toIsoWithOffset } from "@/lib/dates";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Avatar from "@/components/ui/Avatar.astro";

interface Props {
  event: EventEntry;
  locale: Locale;
  /** resolved speakers of the event (optional, shown as a compact avatar stack) */
  speakers?: SpeakerEntry[];
}

const { event, locale, speakers = [] } = Astro.props;
const dict = getUiDictionary(locale);
const status = deriveEventStatus(event);

const formattedDate = formatEventDate(event.startDate, locale, "date", event.timezone);

const venueModeLabels: Record<string, Record<Locale, string>> = {
  in_person: { fr: "En présentiel", en: "In person" },
  online: { fr: "En ligne", en: "Online" },
  hybrid: { fr: "Hybride", en: "Hybrid" },
};

const modeLabel = event.venue?.mode ? (venueModeLabels[event.venue.mode]?.[locale] ?? event.venue.mode) : null;

const summary = event.summary.length > 150 ? event.summary.slice(0, 150) + "…" : event.summary;
const talkCount = event.talks?.length ?? 0;
const stack = speakers.slice(0, 4);
---

<li
  data-testid="event-card"
  class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col gap-3"
>
  <div class="flex items-center gap-2 flex-wrap">
    <StatusBadge {status} {locale} />
    {modeLabel && (
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-azure-50 text-azure-700 border border-azure-200">
        {modeLabel}
      </span>
    )}
    {talkCount > 0 && (
      <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
        {dict.events.talksCount(talkCount)}
      </span>
    )}
  </div>

  <h3 class="text-lg font-semibold text-gray-900 leading-snug">
    <a
      href={getLocalizedRoute(locale, "events", event.slug)}
      class="hover:text-azure-600 transition-colors"
    >
      {event.title}
    </a>
  </h3>

  <div class="flex items-center gap-x-3 gap-y-1 text-sm text-gray-500 flex-wrap">
    <time datetime={toIsoWithOffset(event.startDate, event.timezone)}>{formattedDate}</time>
    {event.venue?.city && <span>{event.venue.city}</span>}
    {event.host && <span>{dict.events.hostedBy} {event.host}</span>}
  </div>

  <p class="text-sm text-gray-600 leading-relaxed">{summary}</p>

  {stack.length > 0 && (
    <div class="mt-auto flex items-center -space-x-2" aria-label={dict.events.speakers}>
      {stack.map((s) => (
        <span class="rounded-full ring-2 ring-white" title={s.name}>
          <Avatar name={s.name} src={s.photo} size="sm" />
        </span>
      ))}
    </div>
  )}
</li>
