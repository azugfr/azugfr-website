---
import type { SpeakerEntry, TalkEntry } from "@/content/config";
import type { Locale } from "@/lib/i18n";
import { getLocalizedRoute, getUiDictionary } from "@/lib/i18n";
import Avatar from "@/components/ui/Avatar.astro";

interface Props {
  talks: TalkEntry[];
  speakersBySlug: Record<string, SpeakerEntry>;
  locale: Locale;
  compact?: boolean;
}

const { talks, speakersBySlug, locale, compact = false } = Astro.props;
const dict = getUiDictionary(locale);

const pill =
  "inline-flex items-center gap-1 text-sm px-3 py-1 rounded-full border border-azure-200 text-azure-700 hover:bg-azure-50";
---

<ol data-testid="agenda" class="relative border-l-2 border-azure-100 ml-3 space-y-8">
  {talks.map((talk) => {
    const speakers = talk.speakerSlugs
      .map((slug) => speakersBySlug[slug])
      .filter((s): s is SpeakerEntry => Boolean(s));
    return (
      <li data-testid="talk" class="ml-6 relative">
        <span
          class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-azure-600 ring-4 ring-white"
          aria-hidden="true"
        />
        {talk.time && <p class="text-sm font-mono text-gray-500">{talk.time}</p>}
        <h3 class="text-lg font-semibold text-gray-900">{talk.title}</h3>
        {!compact && talk.abstract && (
          <p class="mt-1 text-gray-700 leading-relaxed">{talk.abstract}</p>
        )}
        {speakers.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-3">
            {speakers.map((s) => (
              <li class="flex items-center gap-2">
                <Avatar name={s.name} src={s.photo} size="sm" />
                <a
                  href={getLocalizedRoute(locale, "speakers", s.slug)}
                  class="text-sm font-medium text-gray-800 hover:text-azure-700 hover:underline"
                >
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        )}
        {(talk.slidesUrl || talk.videoUrl) && (
          <p class="mt-3 flex flex-wrap gap-2">
            {talk.slidesUrl && (
              <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class={pill}>
                {dict.events.slides}
              </a>
            )}
            {talk.videoUrl && (
              <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class={pill}>
                {dict.events.video}
              </a>
            )}
          </p>
        )}
      </li>
    );
  })}
</ol>
