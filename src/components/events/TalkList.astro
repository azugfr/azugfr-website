---
import type { SpeakerEntry, TalkEntry } from "@/content/config";
import type { Locale } from "@/lib/i18n";
import { getLocalizedRoute, getUiDictionary } from "@/lib/i18n";

interface Props {
  talks: TalkEntry[];
  speakersBySlug: Record<string, SpeakerEntry>;
  locale: Locale;
  compact?: boolean;
}

const { talks, speakersBySlug, locale, compact = false } = Astro.props;
const dict = getUiDictionary(locale);
// The time column only exists when at least one talk has a time
const hasTimes = talks.some((t) => Boolean(t.time));
---

<ol data-testid="agenda" class="border-t border-trait">
  {talks.map((talk) => {
    const speakers = talk.speakerSlugs
      .map((slug) => speakersBySlug[slug])
      .filter((s): s is SpeakerEntry => Boolean(s));
    return (
      <li
        data-testid="talk"
        class:list={["py-5 border-b border-trait gap-x-6 gap-y-1", hasTimes ? "sm:grid sm:grid-cols-[5rem_1fr]" : ""]}
      >
        {hasTimes && (
          <p class="t-meta t-num text-gris">{talk.time}</p>
        )}
        <div class="min-w-0">
          <h3 class="t-h3">{talk.title}</h3>
          {speakers.length > 0 && (
            <p class="mt-1 flex flex-wrap gap-x-4">
              {speakers.map((s) => (
                <a href={getLocalizedRoute(locale, "speakers", s.slug)} class="link text-body">
                  {s.name}
                </a>
              ))}
            </p>
          )}
          {!compact && talk.abstract && (
            <p class="mt-3 measure">{talk.abstract}</p>
          )}
          {(talk.slidesUrl || talk.videoUrl) && (
            <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 t-meta">
              {talk.slidesUrl && (
                <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class="link">
                  {dict.events.slides}
                </a>
              )}
              {talk.videoUrl && (
                <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class="link">
                  {dict.events.video}
                </a>
              )}
            </p>
          )}
        </div>
      </li>
    );
  })}
</ol>
