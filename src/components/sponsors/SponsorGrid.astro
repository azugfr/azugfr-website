---
import type { SponsorEntry } from "@/content/config";
import type { Locale } from "@/lib/i18n/index";
import SponsorCard from "./SponsorCard.astro";

interface Props {
  sponsors: SponsorEntry[];
  locale: Locale;
  title?: string;
}

const { sponsors, locale, title } = Astro.props;
---

{
  sponsors.length > 0 && (
    <section>
      {title && (
        <h2 class="text-2xl font-bold text-gray-900 mb-8">{title}</h2>
      )}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {sponsors.map((sponsor) => (
          <SponsorCard sponsor={sponsor} locale={locale} />
        ))}
      </div>
    </section>
  )
}
