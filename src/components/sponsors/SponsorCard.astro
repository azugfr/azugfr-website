---
import type { SponsorEntry } from "@/content/config";
import type { Locale } from "@/lib/i18n/index";

interface Props {
  sponsor: SponsorEntry;
  locale: Locale;
}

const { sponsor } = Astro.props;

const tierClasses: Record<string, string> = {
  platinum: "bg-azure-100 text-azure-700 border border-azure-200",
  gold: "bg-yellow-100 text-yellow-700 border border-yellow-200",
  silver: "bg-gray-100 text-gray-600 border border-gray-300",
  bronze: "bg-orange-100 text-orange-700 border border-orange-200",
};

const tierClass = sponsor.tier
  ? (tierClasses[sponsor.tier.toLowerCase()] ?? "bg-gray-100 text-gray-600 border border-gray-300")
  : "";
---

<a
  href={sponsor.website}
  target="_blank"
  rel="noopener noreferrer"
  class="bg-white rounded-lg border border-gray-200 p-6 flex flex-col items-center gap-3 hover:shadow-md transition-shadow"
>
  {
    sponsor.logo ? (
      <img
        src={sponsor.logo}
        alt={sponsor.alt ?? sponsor.name}
        class="h-12 object-contain"
      />
    ) : (
      <span class="font-semibold text-gray-700">{sponsor.name}</span>
    )
  }
  <span class="text-sm text-gray-600 text-center">{sponsor.name}</span>
  {
    sponsor.tier && (
      <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${tierClass}`}>
        {sponsor.tier}
      </span>
    )
  }
</a>
