{
  "name": "azugfr-website",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "dev:local": "astro dev --host 127.0.0.1 --port 4321",
    "dev:network": "astro dev --host",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "test": "npm run test:unit && npm run test:check",
    "test:unit": "vitest run",
    "test:check": "astro check && npm run build",
    "test:browser": "playwright test",
    "sync:events": "node scripts/sync-meetup-events.mjs",
    "sync:news": "node scripts/sync-linkedin-news.mjs",
    "sync": "npm run sync:events && npm run sync:news",
    "derive:speakers": "node scripts/derive-speakers.mjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.3",
    "astro": "^5.7.13",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@astrojs/check": "^0.9.8",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
